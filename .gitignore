# 构建产物
/target/
/server/target/

# 服务端的运行时数据：发布的版本产物、访问统计、本机配置。
# 是部署时才产生的东西，不属于源码。
/server/data/

# 本地验证时用的临时目录（离屏渲染产物 / 测试仓库）
/server/.preview/
/server/.testdata/

# 从 dist/ 直接启动服务端时产生的运行时数据（发布过的产物、访问统计、本机配置）
/dist/data/

# 手动留的旧版备份（dist 里只提交当前版本）
/dist/AutoLoginQatarTool v*.exe

# AI 助手的工作记录（不属于项目源码）
/.workbuddy-ai/
