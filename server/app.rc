#include <windows.h>

/* exe 文件图标：资源管理器 / 快捷方式 / 任务栏固定时显示。
   由 `AutoLoginServer.exe --export-icon assets/icons/server.ico` 生成
   （16/20/24/32/40/48/64/128/256 九个尺寸）。
   没有 svg 源文件 —— 图标的几何直接用 GDI+ 写在 src/icon.rs 里。 */
1 ICON "assets/icons/server.ico"

/* 版本号由 build.rs 从 Cargo.toml 的 version 注入（见 build.rs）。
   别在这里硬编码 —— 否则会出现「exe 属性里的版本」和「管理界面显示的版本」不一致。 */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VERSION_COMMA@
PRODUCTVERSION  @VERSION_COMMA@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Qtech"
            VALUE "FileDescription",  "AutoLoginQatarTool 更新服务端"
            VALUE "FileVersion",      "@VERSION_STR@"
            VALUE "InternalName",     "AutoLoginQatarServer"
            VALUE "OriginalFilename", "AutoLoginQatarServer.exe"
            VALUE "ProductName",      "AutoLoginQatarServer"
            VALUE "ProductVersion",   "@VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
